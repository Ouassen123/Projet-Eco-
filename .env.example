# Configuration de l'application - copier en .env et adapter

# Base de données
# Développement local (SQLite, si tu gardes un ancien schéma) :
# DATABASE_URL="file:./dev.db"
# Production / hébergement (PostgreSQL) :
DATABASE_URL="postgresql://user:password@host:5432/ordres_mission?schema=public"

# Secret pour la signature des sessions (HMAC SHA-256)
# Générer avec: openssl rand -hex 32
AUTH_SECRET="change-me-to-a-long-random-string"

# Mettre "false" si l'app est servie en HTTP sur le réseau local (sans HTTPS),
# sinon les navigateurs refusent le cookie de session hors localhost.
# Laisser absent ou "true" en production HTTPS.
# AUTH_SECURE_COOKIE="false"

# Environnement
# NODE_ENV est géré automatiquement par Next.js
